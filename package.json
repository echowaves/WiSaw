{
  "name": "wisaw",
  "version": "7.6.0",
  "buildNumber": "742",
  "versionCode": 742,
  "author": "Echowaves Corp.",
  "license": "MIT",
  "main": "expo-router/entry",
  "ts-standard": {
    "ignore": [
      "src/zxcvbn.js"
    ]
  },
  "scripts": {
    "start": "npx expo start --dev-client",
    "run:ios": "npx expo run:ios",
    "build-ios-for-simulator": "rm -rf ios && npx expo prebuild -p ios && xcodebuild -workspace ios/WiSaw.xcworkspace -scheme WiSaw -sdk iphonesimulator -configuration Debug build && xcrun simctl install booted $(find ~/Library/Developer/Xcode/DerivedData/WiSaw-*/Build/Products/Debug-iphonesimulator -name 'WiSaw.app' -maxdepth 1)",
    "build-android-for-simulator": "rm -rf android && npx expo prebuild -p android && node scripts/fix-gradle-version.js && JAVA_HOME=/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home npx expo run:android",
    "build:android-for-device": "eas build -p android --profile development",
    "build:ios-for-device": "eas build -p ios --profile development",
    "build:ios-for-device-locally": "npx expo run:ios --device",
    "clear": "npm cache clean --force",
    "reset:simulator": "xcrun simctl erase all",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build": "source .env && node scripts/sync-eas-env.js && eas build",
    "publish:prod": "source .env && eas update --branch production",
    "lint": "npx ts-standard",
    "lint:fix": "npx ts-standard --fix"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript",
        "react-native"
      ]
    }
  },
  "dependencies": {
    "@apollo/client": "4.3.5",
    "@expo/metro-runtime": "~58.0.15",
    "@openspacelabs/react-native-zoomable-view": "2.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-community/slider": "5.2.1",
    "@react-native-vector-icons/ant-design": "14.0.0",
    "@react-native-vector-icons/fontawesome": "14.0.0",
    "@react-native-vector-icons/fontawesome5": "14.0.0",
    "@react-native-vector-icons/ionicons": "14.0.0",
    "@react-native-vector-icons/material-design-icons": "14.0.0",
    "@react-native-vector-icons/material-icons": "14.0.0",
    "@types/react": "~19.3.0",
    "expo": "~58.0.21",
    "expo-asset": "~58.0.19",
    "expo-audio": "~58.0.10",
    "expo-background-task": "~58.0.11",
    "expo-build-properties": "~58.0.11",
    "expo-cached-image": "58.0.0",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.17",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.15",
    "expo-location": "~58.0.20",
    "expo-masonry-layout": "58.0.0",
    "expo-media-library": "~58.0.13",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.28",
    "expo-screen-orientation": "~58.0.3",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-storage": "58.0.0",
    "expo-task-manager": "~58.0.12",
    "expo-updates": "~58.0.19",
    "expo-video": "~58.0.13",
    "expo-video-thumbnails": "~58.0.2",
    "graphql": "17.0.2",
    "jotai": "2.20.3",
    "lodash": "4.18.1",
    "prop-types": "15.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-base64": "0.2.2",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-get-random-values": "2.1.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-toast-message": "2.5.2",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "react-qr-code": "2.2.0",
    "typescript": "5.9.3",
    "uuid": "14.0.3"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/runtime": "7.29.10",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "babel-jest": "30.5.2",
    "babel-plugin-module-resolver": "5.0.3",
    "babel-preset-expo": "~58.0.0",
    "eslint": "8.57.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-promise": "7.3.0",
    "jest": "30.5.2",
    "jetifier": "2.0.0",
    "punycode": "2.3.1",
    "react-native-clean-project": "4.0.3",
    "react-test-renderer": "19.3.0",
    "ts-standard": "12.0.2"
  }
}
