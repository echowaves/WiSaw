{
  "name": "wisaw",
  "version": "7.5.7",
  "buildNumber": "721",
  "versionCode": 721,
  "author": "Echowaves Corp.",
  "license": "MIT",
  "main": "expo-router/entry",
  "ts-standard": {
    "ignore": [
      "src/zxcvbn.js"
    ]
  },
  "scripts": {
    "start": "npx expo start --dev-client",
    "build-ios-for-simulator": "rm -rf ios && npx expo prebuild -p ios && xcodebuild -workspace ios/WiSaw.xcworkspace -scheme WiSaw -sdk iphonesimulator -configuration Debug build && xcrun simctl install booted $(find ~/Library/Developer/Xcode/DerivedData/WiSaw-*/Build/Products/Debug-iphonesimulator -name 'WiSaw.app' -maxdepth 1)",
    "build-android-for-simulator": "rm -rf android && npx expo prebuild -p android && node scripts/fix-gradle-version.js && npx expo run:android",
    "build:android-for-device": "eas build -p android --profile development",
    "build:ios-for-device": "eas build -p ios --profile development",
    "build:ios-for-device-locally": "npx expo run:ios --device",
    "clear": "npm cache clean --force",
    "reset:simulator": "xcrun simctl erase all",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build": "source .env && node scripts/sync-eas-env.js && eas build",
    "publish:prod": "source .env && eas update --branch production",
    "lint": "npx ts-standard",
    "lint:fix": "npx ts-standard --fix"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  },
  "dependencies": {
    "@apollo/client": "4.1.6",
    "@expo/metro-runtime": "~56.0.20",
    "@expo/vector-icons": "15.1.1",
    "@openspacelabs/react-native-zoomable-view": "2.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-community/slider": "5.2.0",
    "@types/react": "19.2.18",
    "expo": "~56.0.20",
    "expo-asset": "~56.0.23",
    "expo-audio": "56.0.13",
    "expo-background-task": "~56.0.26",
    "expo-build-properties": "~56.0.26",
    "expo-cached-image": "57.0.0",
    "expo-constants": "~56.0.24",
    "expo-crypto": "56.0.4",
    "expo-dev-client": "~56.0.25",
    "expo-file-system": "~56.0.10",
    "expo-font": "56.0.7",
    "expo-haptics": "56.0.3",
    "expo-image-manipulator": "~56.0.25",
    "expo-image-picker": "~56.0.24",
    "expo-linking": "~56.0.17",
    "expo-location": "~56.0.24",
    "expo-masonry-layout": "2.1.1",
    "expo-media-library": "~56.0.11",
    "expo-notifications": "~56.0.24",
    "expo-router": "~56.2.19",
    "expo-screen-orientation": "56.0.5",
    "expo-secure-store": "56.0.4",
    "expo-splash-screen": "56.0.14",
    "expo-status-bar": "56.0.4",
    "expo-storage": "57.0.0",
    "expo-task-manager": "~56.0.26",
    "expo-updates": "~56.0.25",
    "expo-video": "56.1.4",
    "expo-video-thumbnails": "56.0.3",
    "graphql": "16.13.1",
    "jotai": "2.18.0",
    "prop-types": "15.8.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-base64": "0.2.2",
    "react-native-easy-grid": "0.2.2",
    "react-native-gesture-handler": "2.31.2",
    "react-native-get-random-values": "1.11.0",
    "react-native-keyboard-controller": "1.21.6",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-toast-message": "2.3.3",
    "react-native-vector-icons": "10.3.0",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.8.3",
    "react-qr-code": "2.0.18",
    "react-timer-mixin": "0.13.4",
    "typescript": "5.9.2",
    "uuid": "13.0.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@babel/runtime": "7.28.6",
    "@typescript-eslint/eslint-plugin": "8.56.1",
    "@typescript-eslint/parser": "8.56.1",
    "babel-jest": "29.7.0",
    "babel-plugin-module-resolver": "5.0.2",
    "babel-preset-expo": "56.0.19",
    "eslint": "8.57.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-n": "16.6.2",
    "eslint-plugin-promise": "6.6.0",
    "jest": "29.7.0",
    "jetifier": "2.0.0",
    "punycode": "2.3.1",
    "react-native-clean-project": "4.0.3",
    "react-test-renderer": "19.2.0",
    "ts-standard": "12.0.2"
  }
}
